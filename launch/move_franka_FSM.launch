<launch>

    <!-- ***********************************************************************-->
    <!--  ROSLAUNCH FILE    (http://wiki.ros.org/roslaunch/)                    -->
    <!--                                                                        -->
    <!--  COMMAND-LINE USAGE:                                                   -->
    <!-- (1) roslaunch franka_concerto move_franka.launch                       -->
    <!-- ***********************************************************************-->

    <!-- Argumentos de configuración del launch -->

    <!-- Transformación estática entre base_link y fr3_link0. Esto permite poder ver el URDF del robot en el RViz del brazo  -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="static_tf" args="0 0 0 0 0 0 1 base_link fr3_link0" />

    <!-- Nodo para leer el estado de los botones del manipulador -->
    <arg name="robot_ip" default="$(env FR3_IP)" />
    <arg name="username" default="$(env FR3_desk_user)"/>
    <arg name="password" default="$(env FR3_desk_password)"/>
    
    <node name="buttons_node" pkg="franka_buttons" type="buttons_listener.py" output="screen">
        <param name="robot_ip" value="$(arg robot_ip)" /> 
        <param name="username" value="$(arg username)" />
        <param name="password" value="$(arg password)" /> 
    </node>
    
    <!-- Máquina de estados -->
    <node name="hri_states_machine" pkg="franka_concerto" type="hri_states_machine.py" required="true" output="screen" />

    <!-- Planificador de trayectorias -->
    <group ns="cartesian_path">
        <node name="planner_node" pkg="franka_concerto" type="cartesian_path_planner.py" required="false" output="screen"/>
    </group>

    <!-- Cinemática del brazo -->
    <include file="$(find human_articular_space)/launch/kinematics_right_arm.launch" pass_all_args="true"/>

    <!-- Modelo fusionado -->
    <node name="fusion_model_node" pkg="franka_concerto" type="fusion_model.py" required="true" output="screen" />

    <!-- CONTROLADOR DE LA PINZA SUBACT_GRIPPER -->
    <group ns="gripper_4F">
        <!-- Nodo para la comunicacion entre Arduino y ROS -->
        <node name="serial_sync" pkg="subact_gripper" type="serialSyncroV2.py" required="false" output="screen"/>
    
        <!-- Nodo encargado de abrir y cerrar la pinza mediante la subscripción al topic /gripper_state_desired. -->
        <node name="gripper_control" pkg="subact_gripper" type="gripper_control_rco.py" required="false" output="log" />

        <!-- Nodo encargado de publicar el current_grip_state. estado actual del agarre -->
        <node name="grip_state_pub" pkg="subact_gripper" type="grip_state_publisher_rco.py" required="true" output="log" />
    </group>



</launch>