<launch>
    <arg name="subject" default="" />
    <arg name="yaml_path" default="/media/asensioh/PortableSSD/Experimento nov 2025 optitrack/dataset_csv/task/$(arg subject)/config.yaml" />
    
    <arg name="play_optitrack" default="true" />

    <group ns="exp_optitrack_25">
        
        <rosparam command="load" file="$(arg yaml_path)" />

    </group>

    <!-- launch skeleton -->
    <!-- <include file="$(find skeleton_3d)/launch/process_skeletons_3d.launch" >
        <arg name="use_rviz" value="true" />
        <arg name="dynamic_reconfigure" value="false" />
        <arg name="output" value="log" />
    
    </include> -->

    <!-- rosbag play / rqt_bag -->
    <node pkg="franka_concerto" type="open_rqt_bag.sh" name="abrir_rqt_bag" output="screen" />

    <!-- Optitrack csv player -->
    <group if="$(arg play_optitrack)">   
        <node pkg="franka_concerto" type="optitrack_csv_player.py" name="optitrack_csv_player" output="screen"/>
    </group>

</launch>